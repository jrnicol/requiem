<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1a0d10" />
    <base href="/" />
    <title>Requiem</title>
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="ClientOnly" />
</head>

<body>
    @* Shown until the WebAssembly app has loaded; app.css hides it once the layout renders. *@
    <div class="boot-splash" aria-live="polite">
        <span class="boot-splash-title">Requiem</span>
        <span class="boot-splash-text">Waking from torpor…</span>
    </div>
    <Routes @rendermode="ClientOnly" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    // Runs only in the browser: no server prerender, so pages load their data once, from the API.
    private static readonly IComponentRenderMode ClientOnly = new InteractiveWebAssemblyRenderMode(prerender: false);
}
