@page "/scenes"
@attribute [Authorize(Policy = Policies.GameMaster)]
@inject RequiemApi Api
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Scenes · Requiem</PageTitle>

<MudText Typo="Typo.h4" Class="brand-font mb-1">Scenes</MudText>
<MudText Color="Color.Secondary" Class="mb-4">Group the NPCs you'll run together, then track them at the table.</MudText>

<MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2" Wrap="Wrap.Wrap" Class="mb-4">
    <MudTextField T="string" @bind-Value="_name" Label="New scene" Placeholder="e.g. Elysium at the Orpheum" Variant="Variant.Outlined"
                  Margin="Margin.Dense" MaxLength="200" Immediate="true" OnKeyDown="OnKeyAsync" Style="min-width:16rem" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="mt-1"
               Disabled="string.IsNullOrWhiteSpace(_name) || _creating" OnClick="CreateAsync">Create</MudButton>
</MudStack>

@if (_scenes is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_scenes.Count == 0)
{
    <MudText Color="Color.Secondary">No scenes yet.</MudText>
}
else
{
    <MudGrid Spacing="2">
        @foreach (var scene in _scenes)
        {
            <MudItem xs="12" sm="6" md="4">
                <a href="@($"scenes/{scene.Id}")" class="npc-card-link">
                    <MudPaper Class="pa-3" Elevation="1">
                        <MudText Typo="Typo.h6">@scene.Name</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(scene.MemberCount == 1 ? "1 NPC" : $"{scene.MemberCount} NPCs") · updated @scene.UpdatedAt.ToLocalTime().ToString("d MMM, HH:mm")
                        </MudText>
                    </MudPaper>
                </a>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<SceneSummary>? _scenes;
    private string? _name;
    private bool _creating;

    protected override async Task OnInitializedAsync() => _scenes = await Api.ListScenesAsync();

    private async Task OnKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter") await CreateAsync();
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name) || _creating) return;
        _creating = true;
        try
        {
            var result = await Api.SaveSceneAsync(null, new SceneForm { Name = _name.Trim() });
            if (result.Saved is { } scene) Navigation.NavigateTo($"scenes/{scene.Id}");
            else Snackbar.Add(result.Message ?? "The scene wasn't created.", Severity.Error);
        }
        finally
        {
            _creating = false;
        }
    }
}
