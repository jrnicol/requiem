@* A row of boxes like the paper sheet: filled boxes are points left. Tap a box to fill up to it;
   tap the last filled box to empty it. *@

<div class="tracker-boxes @Class" role="group" aria-label="@($"{Label}: {Current} of {Max}")">
    @for (var i = 0; i < Max; i++)
    {
        var box = i + 1;
        <button type="button" class="@($"tracker-box {(box <= Current ? "filled" : "")}")" disabled="@Disabled"
                aria-label="@($"Set {Label} to {(box == Current ? box - 1 : box)}")" @onclick="() => SetAsync(box == Current ? box - 1 : box)"></button>
    }
    <span class="tracker-count">@Current/@Max</span>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public int Max { get; set; }
    [Parameter] public int Current { get; set; }
    [Parameter] public EventCallback<int> CurrentChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>"willpower" or "vitae" picks the box colour.</summary>
    [Parameter] public string? Class { get; set; }

    private Task SetAsync(int value) => CurrentChanged.InvokeAsync(Math.Clamp(value, 0, Max));
}
