@* One campaign's NPCs, for its Storytellers: search and filter, as profile cards showing every detail. *@
@inject RequiemApi Api
@inject ISnackbar Snackbar

<MudGrid Spacing="2" Class="mb-4">
    <MudItem xs="12" md="6">
        <MudTextField T="string" @bind-Value="_search" Placeholder="Search name, concept or faction"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" DebounceInterval="300" OnDebounceIntervalElapsed="_ => LoadAsync()"
                      OnClearButtonClick="_ => LoadAsync()" Variant="Variant.Outlined" Margin="Margin.Dense"
                      aria-label="Search the NPCs" />
    </MudItem>
    <MudItem xs="12" md="6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
            <MudChipSet T="string" SelectedValue="_kindFilter" SelectedValueChanged="OnKindFilterChanged"
                        SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Variant="Variant.Text"
                        SelectedColor="Color.Primary">
                @foreach (var option in KindOptions)
                {
                    <MudChip Value="option" Text="@option" />
                }
            </MudChipSet>
            <MudSpacer />
            <MudSwitch T="bool" Value="_includeArchived" ValueChanged="OnIncludeArchivedChanged"
                       Color="Color.Primary" Label="Archived" />
        </MudStack>
    </MudItem>
</MudGrid>

@if (_loadFailed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        Couldn't load the NPCs.
        <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LoadAsync">Try again</MudButton>
    </MudAlert>
}
else if (_characters is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_characters.Count == 0)
{
    <MudPaper Outlined="true" Class="pa-8">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.NightsStay" Size="Size.Large" Color="Color.Secondary" />
            @if (IsFiltered)
            {
                <MudText Typo="Typo.h6">No NPCs match</MudText>
                <MudText Color="Color.Secondary">Try a different search or filter.</MudText>
            }
            else
            {
                <MudText Typo="Typo.h6">The city is quiet</MudText>
                <MudText Color="Color.Secondary">Add this campaign's first NPC above.</MudText>
            }
        </MudStack>
    </MudPaper>
}
else
{
    <MudText Color="Color.Secondary" Class="mb-2">@CountText</MudText>
    <NpcProfileCards Npcs="_profiles" ShowLinks="true" EmptyText="No appearance, reputation or backstory yet.">
        <Badges>
            @if (_byId[context.Id] is { IsArchived: var archived, IsShared: var shared } && (archived || shared))
            {
                <MudStack Row="true" Spacing="1" Class="mt-1">
                    @if (archived)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Archive" Class="ma-0">Archived</MudChip>
                    }
                    @if (shared)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Badge" Class="ma-0">Shared</MudChip>
                    }
                </MudStack>
            }
        </Badges>
    </NpcProfileCards>
}

@code {
    private static readonly string[] KindOptions = ["All", .. Enum.GetNames<CharacterKind>()];

    [Parameter, EditorRequired] public Guid CampaignId { get; set; }

    private List<CharacterSummary>? _characters;
    private List<KnownNpc> _profiles = [];
    private Dictionary<Guid, CharacterSummary> _byId = [];
    private bool _loadFailed;
    private string? _search;
    private string _kindFilter = "All";
    private bool _includeArchived;

    private bool IsFiltered => !string.IsNullOrWhiteSpace(_search) || _kindFilter != "All" || _includeArchived;

    private string CountText => _characters!.Count == 1 ? "1 NPC" : $"{_characters.Count} NPCs";

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>Reloads the list, e.g. after an NPC moves in from another campaign.</summary>
    public async Task LoadAsync()
    {
        _loadFailed = false;
        try
        {
            CharacterKind? kind = Enum.TryParse<CharacterKind>(_kindFilter, out var k) ? k : null;
            _characters = await Api.ListCharactersAsync(new CharacterQuery(_search, Kind: kind, IncludeArchived: _includeArchived, CampaignId: CampaignId));
            _profiles = _characters.Select(Profile).ToList();
            _byId = _characters.ToDictionary(c => c.Id);
        }
        catch (HttpRequestException)
        {
            _loadFailed = true;
            Snackbar.Add("Couldn't reach the server.", Severity.Error);
        }
        StateHasChanged();
    }

    private async Task OnKindFilterChanged(string? value)
    {
        _kindFilter = value ?? "All";
        await LoadAsync();
    }

    private async Task OnIncludeArchivedChanged(bool value)
    {
        _includeArchived = value;
        await LoadAsync();
    }

    /// <summary>The same cards as Known NPCs, with every detail filled in rather than only the revealed ones.</summary>
    private static KnownNpc Profile(CharacterSummary c) => new(
        c.Id, c.Name, c.PortraitUrl, c.Faction, c.BloodlineName, c.Generation, c.Appearance, c.Reputation, c.Backstory, c.Kind, c.Tier);
}
