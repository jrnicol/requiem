@* One campaign's NPCs, for its Storytellers: search and filter, as profile cards showing every detail. The players'
   view shows the shared NPCs exactly as players see them, and then searches and filters only on what they know. *@
@inject RequiemApi Api
@inject ISnackbar Snackbar

<MudGrid Spacing="2" Class="mb-4">
    <MudItem xs="12" md="6">
        <MudTextField T="string" @bind-Value="_search" Placeholder="@(_playersView ? "Search what the players know" : "Search name, concept or faction")"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" DebounceInterval="300" OnDebounceIntervalElapsed="_ => LoadAsync()"
                      OnClearButtonClick="_ => LoadAsync()" Variant="Variant.Outlined" Margin="Margin.Dense"
                      aria-label="Search the NPCs" />
    </MudItem>
    <MudItem xs="12" md="6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
            <MudChipSet T="string" SelectedValue="_kindFilter" SelectedValueChanged="OnKindFilterChanged"
                        SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Variant="Variant.Text"
                        SelectedColor="Color.Primary">
                @foreach (var option in KindOptions)
                {
                    <MudChip Value="option" Text="@option" />
                }
            </MudChipSet>
        </MudStack>
    </MudItem>
</MudGrid>

@if (_loadFailed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        Couldn't load the NPCs.
        <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LoadAsync">Try again</MudButton>
    </MudAlert>
}
else if (_profiles is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_profiles.Count == 0)
{
    <MudPaper Outlined="true" Class="pa-8">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.NightsStay" Size="Size.Large" Color="Color.Secondary" />
            @if (IsFiltered)
            {
                <MudText Typo="Typo.h6">No NPCs match</MudText>
                <MudText Color="Color.Secondary">
                    @(_playersView ? "Only what the players know is searched. Try a different search or filter." : "Try a different search or filter.")
                </MudText>
            }
            else if (_playersView)
            {
                <MudText Typo="Typo.h6">Nothing shared yet</MudText>
                <MudText Color="Color.Secondary">Open an NPC, and under Profile switch on "Share with players".</MudText>
            }
            else
            {
                <MudText Typo="Typo.h6">The city is quiet</MudText>
                <MudText Color="Color.Secondary">Add this campaign's first NPC above.</MudText>
            }
        </MudStack>
    </MudPaper>
}
else
{
    <MudText Color="Color.Secondary" Class="mb-2">
        @CountText@(_playersView ? " · exactly what your players see" : "")
    </MudText>
    @if (_playersView)
    {
        <NpcProfileCards Npcs="_profiles" ShowLinks="true" PlayersView="true" />
    }
    else
    {
        <NpcProfileCards Npcs="_profiles" ShowLinks="true" IsShared="id => _byId[id].IsShared" />
    }
}

@code {
    private static readonly string[] KindOptions = ["All", .. Enum.GetNames<CharacterKind>()];

    [Parameter, EditorRequired] public Guid CampaignId { get; set; }
    /// <summary>Set by the page from its address (its switch sits with the new-NPC buttons), so the players' view has a link of its own.</summary>
    [Parameter] public bool PlayersView { get; set; }

    private List<KnownNpc>? _profiles;
    private Dictionary<Guid, CharacterSummary> _byId = [];
    private bool _loadFailed;
    private string? _search;
    private string _kindFilter = "All";
    private bool _playersView;
    private int _loads;

    private bool IsFiltered => !string.IsNullOrWhiteSpace(_search) || _kindFilter != "All";

    private string CountText => _profiles!.Count == 1 ? "1 NPC" : $"{_profiles.Count} NPCs";

    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && PlayersView == _playersView) return;
        _loaded = true;
        _playersView = PlayersView;
        _profiles = null;
        await LoadAsync();
    }

    /// <summary>Reloads the list, e.g. after an NPC moves in from another campaign.</summary>
    public async Task LoadAsync()
    {
        // Loads can overlap (a search still settling when the view switches); only the latest one's results count.
        var load = ++_loads;
        _loadFailed = false;
        try
        {
            CharacterKind? kind = Enum.TryParse<CharacterKind>(_kindFilter, out var k) ? k : null;
            if (_playersView)
            {
                // The players' cards hold only what's revealed, so filtering them can't give away anything else.
                var search = _search?.Trim();
                var known = await Api.GetKnownNpcsAsync(CampaignId);
                if (load != _loads) return;
                _profiles = known
                    .Where(n => kind is null || n.Kind == kind)
                    .Where(n => string.IsNullOrEmpty(search) || KnownText(n).Any(t => t?.Contains(search, StringComparison.OrdinalIgnoreCase) == true))
                    .ToList();
            }
            else
            {
                var characters = await Api.ListCharactersAsync(new CharacterQuery(_search, Kind: kind, CampaignId: CampaignId));
                if (load != _loads) return;
                _profiles = characters.Select(Profile).ToList();
                _byId = characters.ToDictionary(c => c.Id);
            }
        }
        catch (HttpRequestException)
        {
            if (load != _loads) return;
            _loadFailed = true;
            Snackbar.Add("Couldn't reach the server.", Severity.Error);
        }
        StateHasChanged();
    }

    private async Task OnKindFilterChanged(string? value)
    {
        _kindFilter = value ?? "All";
        await LoadAsync();
    }

    private static IEnumerable<string?> KnownText(KnownNpc n) =>
        [n.Name, n.Faction, n.Bloodline, n.Appearance, n.Reputation, n.Backstory, .. n.Titles ?? []];

    /// <summary>The same cards as the players', with every detail filled in rather than only the revealed ones.</summary>
    private static KnownNpc Profile(CharacterSummary c) => new(
        c.Id, c.Name, c.PortraitUrl, c.Faction, c.BloodlineName, c.Generation, c.Appearance, c.Reputation, c.Backstory, c.Kind, c.Tier, c.Titles);
}
