@* Signed in, but this page needs more (e.g. editing the shared catalog needs the site admin). *@
@inject CookieAuthenticationStateProvider Auth
@inject NavigationManager Navigation

<MudStack AlignItems="AlignItems.Center" Class="mt-16" Spacing="3">
    <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Large" Color="Color.Secondary" />
    <MudText Typo="Typo.h5">Not available</MudText>
    <MudText Color="Color.Secondary">Your account can't open this page.</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="campaigns">Go to your campaigns</MudButton>
    <MudButton Variant="Variant.Text" OnClick="SignOutAsync">Sign in as someone else</MudButton>
</MudStack>

@code {
    private async Task SignOutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
