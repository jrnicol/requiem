@* A Known NPC's full profile: the portrait, facts and every revealed description. *@
@inject NavigationManager Navigation

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (Npc.PortraitUrl is { } url)
            {
                <div class="portrait-box" style="align-self:center">
                    <img src="@url" alt="Portrait of @Npc.Name" class="portrait" />
                </div>
            }
            @if (KnownNpcCards.Facts(Npc) is { Length: > 0 } facts)
            {
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">@facts</MudText>
            }
            @foreach (var (label, text) in Texts())
            {
                <div>
                    <MudText Typo="Typo.subtitle2">@label</MudText>
                    <MudText Typo="Typo.body2" Style="white-space: pre-line">@text</MudText>
                </div>
            }
            @if (!Texts().Any())
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Nothing more is known yet.</MudText>
            }
        </MudStack>
    </DialogContent>
    @* The title bar's close button closes it; Storytellers also get their links here. *@
    <DialogActions>
        @if (IsStoryteller)
        {
            <MudButton StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => Go(KnownNpcCards.EditUrl(Npc))">Edit character</MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.Casino" OnClick="() => Go(KnownNpcCards.PlayUrl(Npc))">At the table</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public KnownNpc Npc { get; set; } = null!;
    [Parameter] public bool IsStoryteller { get; set; }

    private IEnumerable<(string Label, string Text)> Texts()
    {
        if (Npc.Appearance is { } appearance) yield return ("Appearance", appearance);
        if (Npc.Reputation is { } reputation) yield return ("Reputation", reputation);
        if (Npc.Backstory is { } backstory) yield return ("Backstory", backstory);
    }

    // Close first, so the dialog doesn't stay open over the page it links to.
    private void Go(string url)
    {
        Dialog.Close();
        Navigation.NavigateTo(url);
    }
}
