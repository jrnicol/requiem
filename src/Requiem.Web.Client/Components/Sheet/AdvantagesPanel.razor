@* The lasting ratings beside Attributes and Skills: Health, Willpower dots, Humanity/Morality, and the vampire's blood.
   The pools they fill (Willpower points, Vitae, wounds) are on the Condition tab. *@

<MudGrid Spacing="2">
    <MudItem xs="12">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body1">Health <b>@Form.Health</b> <MudText Inline="true" Typo="Typo.caption" Color="Color.Secondary">(Stamina + Size)</MudText></MudText>
            <MudNumericField T="int" Value="Form.Size" ValueChanged="v => Update(() => Form.Size = v)" Label="Size"
                             Min="1" Max="10" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:8rem"
                             HelperText="5 unless a merit or flaw changes it" />
        </MudStack>
    </MudItem>

    <MudItem xs="12">
        <DotRating Label="Willpower" Max="10" Min="0" Value="Form.WillpowerDots" ValueChanged="SetWillpowerDotsAsync" />
        <MudText Typo="Typo.caption" Color="Color.Secondary">Set at creation from Wits + Resolve; it doesn't follow later changes.</MudText>
    </MudItem>

    <MudItem xs="12">
        @if (Form.IsVampire)
        {
            <DotRating Label="Humanity" Max="10" Min="0" Value="Form.Humanity ?? 0" ValueChanged="v => Update(() => Form.Humanity = v)" />
        }
        else
        {
            <DotRating Label="Morality" Max="10" Min="0" Value="Form.Morality ?? 0" ValueChanged="v => Update(() => Form.Morality = v)" />
        }
    </MudItem>

    @if (Form.IsVampire)
    {
        <MudItem xs="12">
            <DotRating Label="Blood Potency" Max="10" Value="BloodPotency" ValueChanged="SetBloodPotencyAsync" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudNumericField T="int?" Value="Form.Generation" ValueChanged="v => Update(() => Form.Generation = v)"
                             Label="Generation" Min="1" Max="13" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudSwitch T="bool" Value="Form.IsThinblood" ValueChanged="SetThinbloodAsync" Color="Color.Primary" Label="Thinblood" />
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter, EditorRequired] public FullSheetForm Form { get; set; } = null!;
    [Parameter] public EventCallback Changed { get; set; }

    private int BloodPotency => Form.BloodPotency ?? BloodRules.MinBloodPotency;
    private int MaxVitae => BloodRules.MaxVitae(BloodPotency, Form.IsThinblood);

    private async Task Update(Action change)
    {
        change();
        await Changed.InvokeAsync();
    }

    private Task SetWillpowerDotsAsync(int dots) => Update(() =>
    {
        // Keep a full pool full, and never more points than dots.
        var wasFull = Form.WillpowerCurrent == Form.WillpowerDots;
        Form.WillpowerDots = dots;
        if (wasFull || Form.WillpowerCurrent > dots) Form.WillpowerCurrent = dots;
    });

    private Task SetBloodPotencyAsync(int value) => Update(() =>
    {
        var wasFull = Form.VitaeCurrent == MaxVitae;
        Form.BloodPotency = value;
        if (wasFull || Form.VitaeCurrent > MaxVitae) Form.VitaeCurrent = MaxVitae;
    });

    private Task SetThinbloodAsync(bool value) => Update(() =>
    {
        Form.IsThinblood = value;
        if (value) Form.Generation = GenerationRules.ThinbloodGeneration;
        if (Form.VitaeCurrent > MaxVitae) Form.VitaeCurrent = MaxVitae;
    });
}
