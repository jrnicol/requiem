@* Faction, from the book's list. A faction typed in before the list existed is kept and shown until it's changed. *@

<MudSelect T="string" Value="Value" ValueChanged="ValueChanged" Label="Faction" Clearable="true"
           Variant="Variant" Margin="Margin" aria-label="Faction">
    @foreach (var faction in Factions.All)
    {
        <MudSelectItem T="string" Value="faction">@faction</MudSelectItem>
    }
    @if (Value is { Length: > 0 } other && !Factions.All.Contains(other))
    {
        <MudSelectItem T="string" Value="other">@other (not in the list)</MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.None;
}
