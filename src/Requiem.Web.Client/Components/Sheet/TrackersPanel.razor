@* The pools that go up and down in play: Willpower points and Vitae. The ratings that set them are under Advantages. *@

<MudGrid Spacing="2">
    <MudItem xs="12">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudText Typo="Typo.body2" Style="min-width:6.5rem">Willpower</MudText>
            <TrackerBoxes Label="Willpower" Max="Form.WillpowerDots" Current="Form.WillpowerCurrent" Class="willpower"
                          CurrentChanged="v => AdjustWillpowerAsync(v - Form.WillpowerCurrent)" />
        </MudStack>
    </MudItem>

    @if (Form.IsVampire)
    {
        <MudItem xs="12">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.body2" Style="min-width:6.5rem">Vitae</MudText>
                <TrackerBoxes Label="Vitae" Max="MaxVitae" Current="Form.VitaeCurrent ?? 0" Class="vitae"
                              CurrentChanged="v => AdjustVitaeAsync(v - (Form.VitaeCurrent ?? 0))" />
            </MudStack>
            <ValidationMessage For="() => Form.VitaeCurrent" class="mud-error-text mud-typography-caption" />
        </MudItem>
    }
    else if (Form.IsGhoul)
    {
        <MudItem xs="12">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.body2" Style="min-width:6.5rem">Vitae</MudText>
                <TrackerBoxes Label="Vitae" Max="GhoulRules.MaxVitae" Current="Form.VitaeCurrent ?? 0" Class="vitae"
                              CurrentChanged="v => Update(() => Form.VitaeCurrent = Math.Clamp(v, 0, GhoulRules.MaxVitae))" />
            </MudStack>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@GhoulRules.VitaeReminder</MudText>
            @if ((Form.VitaeCurrent ?? 0) == 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">
                    No Vitae left: they age to their true age at once, unless they drink again.
                </MudAlert>
            }
            <ValidationMessage For="() => Form.VitaeCurrent" class="mud-error-text mud-typography-caption" />
        </MudItem>
    }
</MudGrid>
<ValidationMessage For="() => Form.WillpowerCurrent" class="mud-error-text mud-typography-caption" />

@code {
    [Parameter, EditorRequired] public FullSheetForm Form { get; set; } = null!;
    [Parameter] public EventCallback Changed { get; set; }

    private int MaxVitae => BloodRules.MaxVitae(Form.BloodPotency ?? BloodRules.MinBloodPotency, Form.IsThinblood);

    private async Task Update(Action change)
    {
        change();
        await Changed.InvokeAsync();
    }

    private Task AdjustWillpowerAsync(int delta) =>
        Update(() => Form.WillpowerCurrent = Math.Clamp(Form.WillpowerCurrent + delta, 0, Form.WillpowerDots));

    private Task AdjustVitaeAsync(int delta) =>
        Update(() => Form.VitaeCurrent = Math.Clamp((Form.VitaeCurrent ?? 0) + delta, 0, MaxVitae));
}
