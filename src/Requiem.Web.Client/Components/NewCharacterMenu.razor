@* Floating "New" button: a quick Supporting Cast stat block or a full character sheet. *@

<MudMenu AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.BottomRight" aria-label="New character">
    <ActivatorContent Context="menu">
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Label="New" aria-label="New character"
                OnClick="@(e => menu.ToggleAsync(e))" />
    </ActivatorContent>
    <ChildContent>
        <MudMenuItem Href="npcs/new" Icon="@Icons.Material.Filled.PersonAdd">Supporting Cast NPC</MudMenuItem>
        <MudMenuItem Href="sheets/new" Icon="@Icons.Material.Filled.Description">Full character sheet</MudMenuItem>
    </ChildContent>
</MudMenu>
