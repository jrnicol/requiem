@* One roster entry: who they are, their stat block, and the numbers you need at the table. *@

<MudCard Outlined="true" Class="npc-card">
    <MudCardContent>
        <MudStack Spacing="2">
            <div>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h6" Style="line-height:1.2">@Npc.Name</MudText>
                    @if (Npc.IsArchived)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Archive">Archived</MudChip>
                    }
                </MudStack>
                @if (Subtitle is not null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText>
                }
            </div>

            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                <MudChip T="string" Size="Size.Small" Color="KindColor" Variant="Variant.Filled">@Npc.Kind</MudChip>
                @if (Npc.BloodlineName is not null)
                {
                    <MudTooltip Text="@BloodlineTooltip" Disabled="BloodlineTooltip is null">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                            @Npc.BloodlineName@(Npc.BloodPotency is { } bp ? $" · BP {bp}" : "")
                        </MudChip>
                    </MudTooltip>
                }
                @if (Npc.Tier == CharacterTier.FullSheet)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Description">Full sheet</MudChip>
                }
                @foreach (var edge in EdgeNames)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Tertiary">@edge</MudChip>
                }
            </MudStack>

            @if (Npc is { Physical: { } physical, Mental: { } mental, Social: { } social })
            {
                <div class="stat-line">
                    <MudText Typo="Typo.body2">Physical</MudText>
                    <DotRating Value="physical" ReadOnly="true" Size="Size.Small" />
                    <MudText Typo="Typo.body2">Mental</MudText>
                    <DotRating Value="mental" ReadOnly="true" Size="Size.Small" />
                    <MudText Typo="Typo.body2">Social</MudText>
                    <DotRating Value="social" ReadOnly="true" Size="Size.Small" />
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Health @SupportingCastRules.Health(physical, Npc.Edges)
                    · Willpower @SupportingCastRules.Willpower(mental, Npc.Edges)
                </MudText>
            }
            else if (Npc.Tier == CharacterTier.FullSheet)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Health @(Npc.Health ?? 0)
                    · Willpower @(Npc.WillpowerDots ?? 0)
                    · @(Npc.Kind == CharacterKind.Vampire ? "Humanity" : "Morality") @(Npc.Morality ?? 0)
                </MudText>
            }
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired] public CharacterSummary Npc { get; set; } = null!;
    [Parameter] public BloodlineOption? Bloodline { get; set; }

    private string? Subtitle => string.Join(" · ", new[] { Npc.Concept, Npc.Faction }.Where(s => !string.IsNullOrWhiteSpace(s))) is { Length: > 0 } s ? s : null;

    private string? BloodlineTooltip => Bloodline?.WeaknessName is { } weakness
        ? $"Weakness: {weakness} · Compel: {Bloodline.CompelName}"
        : null;

    private IEnumerable<string> EdgeNames => Enum.GetValues<NpcEdge>()
        .Where(e => e != NpcEdge.None && Npc.Edges.HasFlag(e))
        .Select(e => e == NpcEdge.QuickWitted ? "Quick Witted" : e == NpcEdge.WellConnected ? "Well Connected" : e.ToString());

    private Color KindColor => Npc.Kind switch
    {
        CharacterKind.Vampire => Color.Primary,
        CharacterKind.Ghoul => Color.Secondary,
        _ => Color.Default,
    };
}
