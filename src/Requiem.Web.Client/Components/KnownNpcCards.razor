@* A player's view of the campaign's shared NPCs: only the details the Storyteller has revealed.
   Storytellers see the same cards with the Players' View switch on their NPCs tab. *@

@if (Npcs.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">Nobody yet. Storyteller characters appear here as the Storyteller reveals them.</MudText>
}
else
{
    <NpcProfileCards Npcs="Npcs" />
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<KnownNpc> Npcs { get; set; } = [];
}
