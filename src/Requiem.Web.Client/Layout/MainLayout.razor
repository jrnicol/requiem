@inherits LayoutComponentBase
@inject CookieAuthenticationStateProvider Auth
@inject NavigationManager Navigation
@* Created here so it records every page from the first one on. *@
@inject NavigationHistory History

<MudThemeProvider Theme="RequiemTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="false">
        <AuthorizeView Policy="@Policies.Member">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           aria-label="Toggle navigation" OnClick="() => _drawerOpen = !_drawerOpen" />
        </AuthorizeView>
        <MudText Typo="Typo.h6" Class="brand-font ml-2">Requiem</MudText>
        <MudSpacer />
        <AuthorizeView Context="auth">
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="Account">
                @* MudBlazor 9: a custom activator must open the menu itself. *@
                <ActivatorContent Context="menu">
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.AccountCircle"
                               OnClick="@(e => menu.ToggleAsync(e))">
                        <span class="d-none d-sm-inline">@auth.User.Identity?.Name</span>
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="SignOutAsync">Sign out</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </AuthorizeView>
    </MudAppBar>

    <AuthorizeView Policy="@Policies.Member">
        <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Lg"
                   ClipMode="DrawerClipMode.Always" Elevation="1">
            <MudNavMenu Class="pt-2">
                @* Storyteller tools live inside each campaign you tell. *@
                <MudNavLink Href="campaigns" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Castle">Campaigns</MudNavLink>
                <MudNavLink Href="catalog/powers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AutoStories">Powers</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
    </AuthorizeView>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4 pb-16 px-3 px-sm-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    private async Task SignOutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login", replace: true);
    }
}
