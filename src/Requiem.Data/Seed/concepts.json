// Character Concepts (WoD Core "Concept", PDF p.55–57). A character regains Willpower when they act out
// their Concept as the trigger describes. Descriptions are short summaries; sourcePage is the PDF page.
// Players may also write their own Concept.
[
  { "name": "Addict", "sourcePage": 55,
    "description": "Something or someone you have to have: a drive that takes precedence over everything else.",
    "willpowerTrigger": "Give in completely to your addiction and sate it." },
  { "name": "Architect", "sourcePage": 55,
    "description": "You want to create something lasting, physical or metaphorical, and work to make your vision real.",
    "willpowerTrigger": "Create something of lasting importance." },
  { "name": "Autocrat", "sourcePage": 55,
    "description": "There's the wrong way and your way. Someone has to take charge, and it's you.",
    "willpowerTrigger": "Take control of a situation or group." },
  { "name": "Bon Vivant", "sourcePage": 55,
    "description": "Existence is for pleasure, and you'll have some fun even on serious business.",
    "willpowerTrigger": "Truly enjoy yourself and share your joy with others." },
  { "name": "Bravo", "sourcePage": 55,
    "description": "Might makes right. The strong take what they want, and weakness is an opportunity.",
    "willpowerTrigger": "Achieve success through force: physical, intimidation or social pressure." },
  { "name": "Caregiver", "sourcePage": 55,
    "description": "You care, genuinely or as a useful tool, and you're there when someone needs comfort or aid.",
    "willpowerTrigger": "Successfully comfort or aid someone else." },
  { "name": "Child", "sourcePage": 55,
    "description": "Innocent, or childish and demanding: you need others to care for you.",
    "willpowerTrigger": "Convince someone to care for you or satisfy your needs without reward." },
  { "name": "Competitor", "sourcePage": 55,
    "description": "Life is a challenge to overcome and a chance to prove your greatness.",
    "willpowerTrigger": "Win a competition." },
  { "name": "Conformist", "sourcePage": 56,
    "description": "You need direction and a group to belong to, and offer your abilities to it.",
    "willpowerTrigger": "Your group achieves its goal with your aid." },
  { "name": "Conniver", "sourcePage": 56,
    "description": "Why risk your own hide when others will do it for you? A well-crafted lie is power.",
    "willpowerTrigger": "Trick someone into giving you something you want." },
  { "name": "Curmudgeon", "sourcePage": 56,
    "description": "Jaded and cynical, you see the worst in everything and never miss an \"I told you so\".",
    "willpowerTrigger": "Something bad happens just as you said it would." },
  { "name": "Deviant", "sourcePage": 56,
    "description": "You refuse to fit society's categories or conform to what anyone expects.",
    "willpowerTrigger": "Break with or ignore convention." },
  { "name": "Director", "sourcePage": 56,
    "description": "Order, precision and organization; you can't tolerate chaos.",
    "willpowerTrigger": "Use organization to accomplish a difficult task." },
  { "name": "Fanatic", "sourcePage": 56,
    "description": "You have a cause, and everything else can be sacrificed for it.",
    "willpowerTrigger": "Do something that directly furthers your cause." },
  { "name": "Gallant", "sourcePage": 56,
    "description": "Uplifted by adoration and attention; every new person is someone to impress.",
    "willpowerTrigger": "Truly impress someone." },
  { "name": "Gambler", "sourcePage": 56,
    "description": "Life is risk, and you'll take chances others call foolish for something better.",
    "willpowerTrigger": "Take a chance and come out ahead." },
  { "name": "Judge", "sourcePage": 56,
    "description": "A believer in systems, logic and doing things by the numbers.",
    "willpowerTrigger": "Use careful, systematic reasoning to solve a problem." },
  { "name": "Loner", "sourcePage": 56,
    "description": "You prefer your own company and go your own way.",
    "willpowerTrigger": "Accomplish something on your own that benefits someone else." },
  { "name": "Martyr", "sourcePage": 56,
    "description": "Made to suffer, you bear it with dignity, sincerely or for the sympathy it brings.",
    "willpowerTrigger": "Sacrifice yourself for your ideals or for someone else's good." },
  { "name": "Masochist", "sourcePage": 56,
    "description": "You test your endurance against anything, and enjoy the pain.",
    "willpowerTrigger": "Suffer in a way you never have before." },
  { "name": "Monster", "sourcePage": 57,
    "description": "Evil incarnate, free to stalk the world; no atrocity is beyond you.",
    "willpowerTrigger": "Commit a terrible act of evil." },
  { "name": "Pedagogue", "sourcePage": 57,
    "description": "Knowledge is worthless unless shared, so you teach.",
    "willpowerTrigger": "Someone benefits from wisdom you shared with them." },
  { "name": "Penitent", "sourcePage": 57,
    "description": "A sinner seeking forgiveness, trying to make up for past mistakes.",
    "willpowerTrigger": "Feel you've made a step toward redemption." },
  { "name": "Perfectionist", "sourcePage": 57,
    "description": "You expect perfection from yourself, and the results show it.",
    "willpowerTrigger": "Perform a task perfectly." },
  { "name": "Rebel", "sourcePage": 57,
    "description": "Authority must be challenged, and you buck the system at every chance.",
    "willpowerTrigger": "Successfully weaken authority." },
  { "name": "Rogue", "sourcePage": 57,
    "description": "You look out for number one, owe nobody, and stay out of others' business.",
    "willpowerTrigger": "Your self-centered attitude brings you success." },
  { "name": "Survivor", "sourcePage": 57,
    "description": "What doesn't kill you makes you stronger; you always find a way through.",
    "willpowerTrigger": "Endure hardship, or encourage others to." },
  { "name": "Thrill Seeker", "sourcePage": 57,
    "description": "Danger makes you feel alive; there's hardly a challenge you won't try.",
    "willpowerTrigger": "Succeed at a dangerous task you deliberately took on." },
  { "name": "Traditionalist", "sourcePage": 57,
    "description": "Tradition means comfort, predictability and stability.",
    "willpowerTrigger": "Time-honored ways turn out to be the best." },
  { "name": "Trickster", "sourcePage": 57,
    "description": "Existence is a cosmic joke; you find the humor and lighten the mood.",
    "willpowerTrigger": "Lift others' spirits, or deny your own pain, through humor." },
  { "name": "Visionary", "sourcePage": 57,
    "description": "You see what the world might be and challenge society's limits to get there.",
    "willpowerTrigger": "Inspire others to follow their dreams or ideals." }
]
