// Merits and Flaws. WoD Core: merits PDF p.96–102, flaws p.103–107. Vampire: merits p.138–140, flaws p.141–142.
// "cost" is the rating as printed; minDots/maxDots bound the dot picker.
// Flaws earn their point value in XP once per game when they cause real trouble, and can be bought off for 5 × points (WoD p.103).
// Where both books have an entry with the same name, the Vampire version applies to vampires.
[
  // ---------- World of Darkness Core: Merits ----------
  { "name": "Allies", "kind": "Merit", "source": "WodCore", "cost": "1–3", "minDots": 1, "maxDots": 3, "sourcePage": 96,
    "description": "A specified ally who gets things done outside the usual channels; dots set their power and influence (1 a beat cop, 2 a police chief, 3 the mayor)." },
  { "name": "Ambidextrous", "kind": "Merit", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 96,
    "description": "Use either hand equally well for tasks needing manual dexterity. When splitting an attack dice pool, +1 to each pool." },
  { "name": "Belongings", "kind": "Merit", "source": "WodCore", "cost": "1–3", "minDots": 1, "maxDots": 3, "sourcePage": 96,
    "description": "A signature item, tools, relic or property that can't easily be sold. Sum up its function in a word or phrase; when that applies in an obvious, meaningful way, gain bonus dice equal to the dots." },
  { "name": "Berserker", "kind": "Merit", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 96,
    "description": "In combat: ignore wound penalties for being Taken Out only, +1 Strength, fearless, immune to illusions and mind- or emotion-affecting powers. Afterward roll Morality: 2+ successes calm down in a few hours; 1 success gain Madness (or worsen one) for a week; 0 for a year and a day; botch permanently." },
  { "name": "Boon", "kind": "Merit", "source": "WodCore", "cost": "1–3", "minDots": 1, "maxDots": 3, "sourcePage": 96,
    "description": "One use only, then the Merit is gone. A powerful person owes you a favor worth 1–3 dots of narrative effect (3: they likely owe you their life)." },
  { "name": "Code of Honor", "kind": "Merit", "source": "WodCore", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 96,
    "description": "A detailed personal code you follow even in frenzy. +2 dice on Morality rolls when at risk of violating it; automatically resist most temptations and Social Compels against it; +2 dice to resist (or −2 to the opponent's) supernatural persuasion to break it." },
  { "name": "Combat Dodge", "kind": "Merit", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 96,
    "description": "When dodging, add Brawl or Weaponry dots (chosen when taken) to Defense instead of doubling it. Works only where your fists or weapon can interfere: Brawl, Weaponry, thrown weapons, and Firearms within striking range." },
  { "name": "Concentration", "kind": "Merit", "source": "WodCore", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 96,
    "description": "Dice pool penalties from distraction, chaos or other inauspicious circumstances are limited to −1." },
  { "name": "Contacts", "kind": "Merit", "source": "WodCore", "cost": "1 per contact", "minDots": 1, "sourcePage": 96,
    "description": "Each point is one source of information in an area of influence (police, hospitals, mafia, press…). They give information, sometimes at a price, but won't help in times of need." },
  { "name": "Daredevil", "kind": "Merit", "source": "WodCore", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 97,
    "description": "When you add an extra complication or hardship to an over-the-top, dangerous action, ignore one botch die on it." },
  { "name": "Destiny", "kind": "Merit", "source": "WodCore", "cost": "1–5", "minDots": 1, "maxDots": 5, "sourcePage": 97,
    "description": "A great destiny guides you. Dots are Destiny points: spend one when facing insurmountable conflict, death or ruin and fate intervenes. Spent points never return. Every Destiny has a Bane; in scenes involving it, botch dice (1s) are doubled." },
  { "name": "Determination", "kind": "Merit", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 97,
    "description": "+3 dice when spending Willpower (instead of +2)." },
  { "name": "Dirty Fighting", "kind": "Merit", "source": "WodCore", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 97,
    "description": "Takes an open Subterfuge Specialty slot. Once per round, roll Subterfuge +2 against one target; successes reduce their Defense (minimum 0).",
    "restrictions": "Needs an open Subterfuge Specialty slot." },
  { "name": "Dual Nature", "kind": "Merit", "source": "WodCore", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 97,
    "description": "Two compatible Virtues; regain Willpower from either." },
  { "name": "Eidetic Memory", "kind": "Merit", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 97,
    "description": "With 1+ success on Intelligence + Perception, recall any sight or sound accurately; 5 successes recall an event perfectly." },
  { "name": "Fame", "kind": "Merit", "source": "WodCore", "cost": "1–3", "minDots": 1, "maxDots": 3, "sourcePage": 97,
    "description": "Public recognition: +1 per dot to Social rolls among those impressed. Drawback: the same +1 per dot applies to Wits + Resolve rolls to recognize you in public." },
  { "name": "Fighting Style", "kind": "Merit", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 98,
    "description": "Choose one style (may be taken multiple times, up to Intelligence): Sword and Shield (reset stance each round for free); Jiu-jitsu (grappled foes can't use weapons; hold for Stamina + Size rounds to knock out or paralyze); Improvised Weapons (no penalty, +1 damage); Line Bowman (+2 to hit beyond 50 yards); Dualist (+2 Wits/Resolve one-on-one; Wits + Weaponry to parry or riposte similar weapons); Cavalier (mounted +1 Defense to mount, +1 damage, double-damage charge); Florentine Swordfighter (dual wield, +1 to each split pool).",
    "restrictions": "Number of styles taken is limited to Intelligence." },
  { "name": "Fire Walker", "kind": "Merit", "source": "WodCore", "cost": "4", "minDots": 4, "maxDots": 4, "sourcePage": 98,
    "description": "Pain fuels you: add your single highest wound modifier as bonus damage to any successful attack.",
    "restrictions": "Can't be combined with Unshakable." },
  { "name": "Gallows Humor", "kind": "Merit", "source": "WodCore", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 98,
    "description": "When death seems certain, gain a free Willpower point to spend if you can make everyone around you laugh." },
  { "name": "Grit", "kind": "Merit", "source": "WodCore", "cost": "1–3 (up to 5)", "minDots": 1, "maxDots": 5, "sourcePage": 98,
    "description": "+1 per dot to Fear checks. Each time you help defeat a Fearmonger you may buy another dot, to a maximum of 5." },
  { "name": "Guardian Angel", "kind": "Merit", "source": "WodCore", "cost": "5", "minDots": 5, "maxDots": 5, "sourcePage": 98,
    "description": "Something unknown watches over you and may protect you in great need. Never guaranteed; the Storyteller decides why and what." },
  { "name": "Huge Size", "kind": "Merit", "source": "WodCore", "cost": "4", "minDots": 4, "maxDots": 4, "sourcePage": 98,
    "description": "Size 6 instead of 5, so +1 Health." },
  { "name": "Iron Will", "kind": "Merit", "source": "WodCore", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 98,
    "description": "Social Attacks against you do 1 less Willpower damage." },
  { "name": "Iron Gut", "kind": "Merit", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 98,
    "description": "+2 dice to resist poison and disease; you can happily eat anything nourishing, however rotten." },
  { "name": "Level-Headed", "kind": "Merit", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 99,
    "description": "After drawing Action Cards in combat, discard your lowest and draw again (not if the first draw was a black Joker)." },
  { "name": "Lightning Calculator", "kind": "Merit", "source": "WodCore", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 99,
    "description": "+2 automatic successes on rolls to crunch numbers, run calculations or analyze data." },
  { "name": "Luck", "kind": "Merit", "source": "WodCore", "cost": "3 or 5", "minDots": 3, "maxDots": 5, "sourcePage": 99,
    "description": "Repeat 1 failed roll per game night (3 points) or 3 (5 points), only where chance could play a part. One repeat per roll." },
  { "name": "MacGyver", "kind": "Merit", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 99,
    "description": "With plausible parts and a narrated method, roll Intelligence + Crafts +2 to improvise a needed item (usually good for one use). Botch ruins the parts." },
  { "name": "Mentor", "kind": "Merit", "source": "WodCore", "cost": "1–5", "minDots": 1, "maxDots": 5, "sourcePage": 99,
    "description": "A teacher who advises and may act for you; dots set their skill, experience and influence, from a specialist (1) to a towering patron with an agenda for you (5). May ask for favors in return." },
  { "name": "Multilingual", "kind": "Merit", "source": "WodCore", "cost": "Variable", "minDots": 1, "sourcePage": 99,
    "description": "The first point grants fluency in a number of languages equal to Intelligence (including your own); each extra language is 1 point. A character learning one language later in life takes 1 dot for just that language." },
  { "name": "Occult Library", "kind": "Merit", "source": "WodCore", "cost": "1–3", "minDots": 1, "maxDots": 3, "sourcePage": 99,
    "description": "A library of occult material for research; dots set its breadth and dice bonus. Pairs well with Academics (Occult Lore)." },
  { "name": "Poise", "kind": "Merit", "source": "WodCore", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 100,
    "description": "Rolls to Socially Compel or Socially Command you are at −1." },
  { "name": "Professional", "kind": "Merit", "source": "WodCore", "cost": "1–3", "minDots": 1, "maxDots": 3, "sourcePage": 100,
    "description": "A specific profession (surgeon, not 'soldier'). Re-roll dice equal to dots on rolls that directly apply the profession and its tools; accept the new result. 1 entry level, 2 seasoned leader, 3 best in the world." },
  { "name": "Reputation", "kind": "Merit", "source": "WodCore", "cost": "1–3", "minDots": 1, "maxDots": 3, "sourcePage": 100,
    "description": "A word or phrase you're known for (Negotiator, Butcher…). Dots add to Social pools where it's respected, and subtract where it's not." },
  { "name": "Resources", "kind": "Merit", "source": "WodCore", "cost": "1–5", "minDots": 1, "maxDots": 5, "sourcePage": 100,
    "description": "Income and liquid assets. 0 abjectly poor (the starting default); 1 low income; 2 middle class; 3 upper class; 4 wealthy; 5 the top 1%." },
  { "name": "Retainer", "kind": "Merit", "source": "WodCore", "cost": "1–5", "minDots": 1, "maxDots": 5, "sourcePage": 100,
    "description": "One loyal aide per purchase. 1 a child, automaton or madman; 2 an ordinary person; 3 a capable employee; 4 an experienced, irreplaceable assistant; 5 an extraordinary follower. Drawback: they can be hurt, killed or driven off by abuse, and the points are lost." },
  { "name": "Sand", "kind": "Merit", "source": "WodCore", "cost": "1–2", "minDots": 1, "maxDots": 2, "sourcePage": 101,
    "description": "1 point of natural Soak against Bashing damage per dot." },
  { "name": "Status", "kind": "Merit", "source": "WodCore", "cost": "1–5", "minDots": 1, "maxDots": 5, "sourcePage": 101,
    "description": "Standing in one organization per purchase (police, City Hall, criminals…). Works only through official channels; adds dots as bonus dice to Manipulation + Persuasion or Intrigue requests within your authority (−1 browbeating, −2 threats or skirting limits, −3 to −5 exceeding them). Samples: City Police, Clerical Standing, Corporate Executive, Diplomat, Licensed Professional, Medical, Military, Rotary Club.",
    "restrictions": "Some organizations have prerequisites: Clerical Standing needs Academics (Religion); Diplomat needs Manipulation 2 and Persuasion 2; Licensed Professional needs a matching Specialty." },
  { "name": "Striking Looks", "kind": "Merit", "source": "WodCore", "cost": "2 or 3", "minDots": 2, "maxDots": 3, "sourcePage": 102,
    "description": "+1 die (2 points) or +2 dice (3 points) to Charisma or Manipulation rolls that use your looks. Drawback: hard to avoid notice; witnesses remember you." },
  { "name": "Survivalist", "kind": "Merit", "source": "WodCore", "cost": "1–3", "minDots": 1, "maxDots": 3, "sourcePage": 102,
    "description": "Living off the land in hostile environments. Intelligence + Crafts: each success is a day's food for one person (up to Stamina people); daily Perception + Investigation to work toward a destination when lost. Defensive survival only." },
  { "name": "Time Sense", "kind": "Merit", "source": "WodCore", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 102,
    "description": "Know the time of day, and how much time has passed, to within a minute or two." },
  { "name": "Trained Soldier", "kind": "Merit", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 102,
    "description": "Teamwork with others who have this Merit (all NPC soldiers do): +1 per such ally to tactical Academics; in combat +1 Defense per ally covering you (max +3); +1 per ally to Wits + Perception against surprise (max +3). No benefit alone." },
  { "name": "Trained Warrior", "kind": "Merit", "source": "WodCore", "cost": "4", "minDots": 4, "maxDots": 4, "sourcePage": 102,
    "description": "Warpaint or terror gear: Charisma + Expression, on 1+ success +1 to intimidating Persuasion and enemy Defense −1 (minimum 1) for the scene. Study a foe 2+ rounds, then Intelligence + their attack skill for +1 Defense against them. With a signature weapon, your first Hit Location Shift is free.",
    "restrictions": "The warpaint effect doesn't combine with similar merits such as Dirty Fighting." },
  { "name": "Unshakable", "kind": "Merit", "source": "WodCore", "cost": "4", "minDots": 4, "maxDots": 4, "sourcePage": 102,
    "description": "Total wound penalties never reduce your dice pools by more than −1.",
    "restrictions": "Can't be combined with Fire Walker." },

  // ---------- World of Darkness Core: Flaws ----------
  { "name": "Addiction", "kind": "Flaw", "source": "WodCore", "cost": "1 or 2", "minDots": 1, "maxDots": 2, "sourcePage": 103,
    "description": "Activity (1) or drug/substance (2). Each day without it, a cumulative −2 to all pools; deprived, you become irate, paranoid, scatterbrained and sickly until you partake." },
  { "name": "Ailing", "kind": "Flaw", "source": "WodCore", "cost": "1–3", "minDots": 1, "maxDots": 3, "sourcePage": 103,
    "description": "A body part doesn't work properly. Options: Bad Sight (2, −2 to vision rolls); Color Blindness (1); Crippled (3, −3 on rolls using the missing limb); Disfigured (1, −2 social; not for Nosferatu); Hard of Hearing (1, hearing rolls 2 harder); Mute (3); Speech Impediment (1, relevant rolls 2 harder). Record the option as the qualifier." },
  { "name": "Amnesia", "kind": "Flaw", "source": "WodCore", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 103,
    "description": "No memory of your past. You may also take up to five points of unspecified Flaws for the Storyteller to reveal over the chronicle." },
  { "name": "Big Mouth", "kind": "Flaw", "source": "WodCore", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 103,
    "description": "You speak before you think, blurting out plans and secrets. No one trusts you twice." },
  { "name": "Bloodthirsty", "kind": "Flaw", "source": "WodCore", "cost": "2 or 3", "minDots": 2, "maxDots": 3, "sourcePage": 103,
    "description": "2: −2 in all Social situations; insulted, mocked or endangered, you must fight until someone drops. 3: any challenge calls for Morality −2; fail means murderous rage, botch adds a mental illness. Either way you're immune to intimidation, fear and mind-affecting powers." },
  { "name": "Child", "kind": "Flaw", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 103,
    "description": "A child's body: −2 on rolls where being taken seriously matters; setting-flaw rolls (Frenzy, Rage, Hubris…) are 2 harder." },
  { "name": "Cowardice", "kind": "Flaw", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 103,
    "description": "−4 to resist Fear, Persuasion or Intimidation against you; you break under the threat of torture. In combat you avoid direct action; acting directly costs 1 Willpower." },
  { "name": "Cursed", "kind": "Flaw", "source": "WodCore", "cost": "1–3", "minDots": 1, "maxDots": 3, "sourcePage": 104,
    "description": "A specific supernatural curse, very hard to lift. Examples: betrayed secrets harm you (1); you stutter describing what you saw (1); tools break in your hands (1); you make enemies of those you grow attached to (2); every achievement eventually turns to failure (3)." },
  { "name": "Damned", "kind": "Flaw", "source": "WodCore", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 104,
    "description": "Destined for hell: 1 less die on Morality checks." },
  { "name": "Dark Fate", "kind": "Flaw", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 104,
    "description": "A horrible end awaits and you have visions of it; the malaise they cause is overcome only with Willpower. When and how is up to the Storyteller." },
  { "name": "Dark Secret", "kind": "Flaw", "source": "WodCore", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 104,
    "description": "A secret that would make you a pariah if uncovered." },
  { "name": "Debt", "kind": "Flaw", "source": "WodCore", "cost": "1–3", "minDots": 1, "maxDots": 3, "sourcePage": 104,
    "description": "1: a car's worth or a house down payment. 2: a gambling debt of 3–5 years' income. 3: you owe someone your life, and they collect in dangerous or humiliating favors." },
  { "name": "Diminutive", "kind": "Flaw", "source": "WodCore", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 104,
    "description": "Well below average stature: Size −1." },
  { "name": "Enemy", "kind": "Flaw", "source": "WodCore", "cost": "1–3", "minDots": 1, "maxDots": 3, "sourcePage": 104,
    "description": "An enemy or group seeking to harm you, from near your own power (1) to Methuselahs or the FBI (3). Dangerous on their turf; they don't usually hunt you everywhere. Variant, Sleeping With the Enemy: an intimate tie to someone in an opposing sect or organization that your superiors would call treason." },
  { "name": "Fortune's Fool", "kind": "Flaw", "source": "WodCore", "cost": "2 or 3", "minDots": 2, "maxDots": 3, "sourcePage": 104,
    "description": "2: drawing a black Joker gives the worst possible outcome. 3: as well, 1s you roll cancel successes." },
  { "name": "Geezer", "kind": "Flaw", "source": "WodCore", "cost": "1 or 3", "minDots": 1, "maxDots": 3, "sourcePage": 104,
    "description": "The lower tier: Stamina −1 (needs 2+) and max Stamina 4, but +3 merit points for Skills at creation. 3: Strength, Dexterity and Stamina −1 each (all need 2+), each capped at 4, but +5 merit points for anything except those three. Note: the heading says '1 or 3' but the text describes the lower tier as 2 points." },
  { "name": "Haunted", "kind": "Flaw", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 105,
    "description": "A hostile ghost only you (and mediums) perceive. Once per night each, it can hide small objects, chill others, buzz in ears, move or break small things, trip you, or make eerie noises. Aggravated, it screams, forcing a Panic Wits + Resolve roll against its 3d10 + 1 success." },
  { "name": "High-Falutin'", "kind": "Flaw", "source": "WodCore", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 105,
    "description": "−2 to rolls interacting with people beneath your station, or in places beneath your means." },
  { "name": "Illiterate", "kind": "Flaw", "source": "WodCore", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 105,
    "description": "You can't read or write." },
  { "name": "Illness", "kind": "Flaw", "source": "WodCore", "cost": "1–3", "minDots": 1, "maxDots": 3, "sourcePage": 105,
    "description": "Incurable. Each session roll Stamina (+2 with a doctor) needing 1 (Minor), 3 (Chronic) or 5 (Fatal) successes; failure applies the penalty to all checks that session; a botch worsens it a level for the session, and a botch at Fatal means you're dying." },
  { "name": "Intolerance", "kind": "Flaw", "source": "WodCore", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 105,
    "description": "An unreasoning dislike of something non-trivial: −2 to rolls involving it, and a greater chance to frenzy, rage or lash out." },
  { "name": "Madness", "kind": "Flaw", "source": "WodCore", "cost": "1–3", "minDots": 1, "maxDots": 3, "sourcePage": 106,
    "description": "A patently untrue belief you must connect to every scene. Each new scene roll Resolve: botch, inflict your madness on the scene; fail, wander off into it (−2 to all rolls if snapped back); success, carry on. Types: Absent Minded 1, Compulsion 1, Delusion 2, Eccentricity 1, Evil Deeds 2, Minor Phobia 1 (−2), Major Phobia 3 (−4), Mumbler 1, Paranoia 2, Schizophrenia 3, Megalomania 2. Record the type as the qualifier. Removed only through the Storyteller's Curing the Insane rules." },
  { "name": "Miser", "kind": "Flaw", "source": "WodCore", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 106,
    "description": "Always buys the cheapest, haggles over everything, uses second-hand gear and does it all yourself." },
  { "name": "Mistaken Identity", "kind": "Flaw", "source": "WodCore", "cost": "1 or 2", "minDots": 1, "maxDots": 2, "sourcePage": 106,
    "description": "You're mistaken for someone infamous: their allies and enemies approach you. 1 an inconvenience, 2 dangerous to you and your allies." },
  { "name": "Nightmares", "kind": "Flaw", "source": "WodCore", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 107,
    "description": "Nightmares of your past and those you've wronged. Roll Wits on waking: botch, Madness for a week; fail, lose 1 Willpower; success, fine for now." },
  { "name": "Notoriety", "kind": "Flaw", "source": "WodCore", "cost": "1 or 2", "minDots": 1, "maxDots": 2, "sourcePage": 107,
    "description": "A bad reputation of your own with a group: −2 to social rolls with them. 1 occasionally, 2 nearly every session.",
    "restrictions": "Can't be taken with the Reputation merit." },
  { "name": "Obese", "kind": "Flaw", "source": "WodCore", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 107,
    "description": "Size +1, Stamina −1, Speed halved; dodging adds only +1 Defense instead of doubling it. Many places you can't fit or hide." },
  { "name": "Overconfident", "kind": "Flaw", "source": "WodCore", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 107,
    "description": "You never turn down a dangerous situation or personal challenge, and blame others when you fail." },
  { "name": "Randy", "kind": "Flaw", "source": "WodCore", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 107,
    "description": "A relentless lech: −3 to Social rolls influencing 'respectable' people, and −3 to resist the charms of those of lesser morals." },
  { "name": "Soft-Hearted", "kind": "Flaw", "source": "WodCore", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 107,
    "description": "Witnessing suffering gives −2 to all rolls for the next scene; causing it brings nights of nausea and grief." },
  { "name": "Vengeance", "kind": "Flaw", "source": "WodCore", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 107,
    "description": "Revenge on someone is your first priority in every situation; only Willpower suppresses it, and only temporarily." },
  { "name": "Ward", "kind": "Flaw", "source": "WodCore", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 107,
    "description": "You protect a mortal, played by the Storyteller, who is a frequent target of your enemies." },
  { "name": "Weakness", "kind": "Flaw", "source": "WodCore", "cost": "1 or 2", "minDots": 1, "maxDots": 2, "sourcePage": 107,
    "description": "A supernatural bane beyond your kind's usual ones. 1: −1 to all actions within ~30 m of it. 2: 1 Bashing per round in the area, and 1 Lethal if pressed against you." },
  { "name": "Weak-Willed", "kind": "Flaw", "source": "WodCore", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 107,
    "description": "Willpower can be spent only when physical harm or life and death is at stake, and Resolve counts as 1 lower against Social Attacks or Influence." },

  // ---------- Vampire: Merits ----------
  { "name": "Demesne", "kind": "Merit", "source": "Vampire", "cost": "Variable (1 per feature)", "minDots": 1, "sourcePage": 138,
    "description": "A place known to the city's vampires as yours. Each dot buys a feature: Hidden Armory (kit for 2); Cell (holds 2 prisoners); Watchmen (paid guards and a boss); Laboratory (+2 science Academics/Crafts); Library (+2 research); Location (+2 where the location matters); Luxury (+2 Social with mortal guests); Postern (secret exit); Security System (+2 against intrusion); Surgery (+2 medical); Herd (up to 3 Vitae a night safely; each Vitae over that rolls 1d10, and any 1 means the Herd is lost)." },
  { "name": "Devil's Advocate", "kind": "Merit", "source": "Vampire", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 138,
    "description": "You and your Beast are close: +2 dice when rolling to Ride the Wave.",
    "restrictions": "Not for Brujah." },
  { "name": "Eat Food", "kind": "Merit", "source": "Vampire", "cost": "Awarded through plot only", "sourcePage": 138,
    "description": "You can eat food, which other vampires find disgusting but which helps the Masquerade.",
    "restrictions": "Lost at Humanity 4 or lower." },
  { "name": "Efficient Digestion", "kind": "Merit", "source": "Vampire", "cost": "2 or 4", "minDots": 2, "maxDots": 4, "sourcePage": 138,
    "description": "Whenever you drink blood, gain +1 Vitae (2 points) or +2 Vitae (4 points)." },
  { "name": "Elder", "kind": "Merit", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 138,
    "description": "Known and feared as an elder: issue commands, cow others, demand minor secrets, ignore other vampires' plots and shirk any organization's authority with social immunity.",
    "restrictions": "Generation 8 or lower and Blood Potency 6 or higher." },
  { "name": "Inoffensive to Animals", "kind": "Merit", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 139,
    "description": "Animals treat you as a mortal; reduces the high-Blood Potency animal penalty by 1." },
  { "name": "Intoxicating", "kind": "Merit", "source": "Vampire", "cost": "5", "minDots": 5, "maxDots": 5, "sourcePage": 139,
    "description": "Once you feed in earnest (2+ Vitae), the victim is swept up in euphoria whatever they felt before; only while feeding.",
    "restrictions": "Can't be taken with the Agony flaw." },
  { "name": "Lick", "kind": "Merit", "source": "Vampire", "cost": "5", "minDots": 5, "maxDots": 5, "sourcePage": 139,
    "description": "Licking the wound after feeding leaves nothing but a faint red mark for an hour or so." },
  { "name": "Light Sleeper", "kind": "Merit", "source": "Vampire", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 139,
    "description": "Wake instantly and alert at any sign of danger; daytime dice limits from Humanity/Morality are waived." },
  { "name": "Prestigious Sire", "kind": "Merit", "source": "Vampire", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 139,
    "description": "Your sire's great status marks you: most treat you with respect (some with contempt), with bonus dice or preferential treatment among those who know them, and possible aid from their contacts." },
  { "name": "Puppetmaster", "kind": "Merit", "source": "Vampire", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 139,
    "description": "An elite Proxy: +2 dice when it does its specialty. Choose one (may be taken multiple times): Assassins (Stealth), Scribes (Investigation), Sycophants (Intrigue), Sirens (Persuasion), Brutes (Brawl and Weaponry)." },
  { "name": "Second Sight", "kind": "Merit", "source": "Vampire", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 139,
    "description": "A brush with death in mortal life lets you see Shades, though you can't interact with them. Write up that past." },
  { "name": "Skinwalker", "kind": "Merit", "source": "Vampire", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 139,
    "description": "At Protean 4+, partially shift any body part of an animal you can take in Wild Form (e.g. bat wings that fly), as Claws of the Wild with the part chosen by you. Not usable in Wild Form.",
    "restrictions": "Protean only." },
  { "name": "Soulless", "kind": "Merit", "source": "Vampire", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 139,
    "description": "You can't be photographed or filmed." },
  { "name": "Touchstone", "kind": "Merit", "source": "Vampire", "cost": "3", "minDots": 3, "maxDots": 3, "sourcePage": 140,
    "description": "A living human who represents what you valued in life. While neither Damaged nor Destroyed, you can't lose your last 2 Humanity dots, failed Stains rolls don't give Stains if you grieve with them (botches still do), Stains rolls get +1 if you've spent time with them, and a Humanity Milestone they helped with removes Stains from Humanity 4. Damaged: Stains rolls −1 until restored. Destroyed: maximum Humanity −1 forever and the Merit is lost." },
  { "name": "Unbondable", "kind": "Merit", "source": "Vampire", "cost": "5", "minDots": 5, "maxDots": 5, "sourcePage": 140,
    "description": "You can never be Blood Bound (so can't gain a Bloodline) and can't Blood Bond others. Needs a meaningful backstory.",
    "restrictions": "Not for magi." },

  // ---------- Vampire: Flaws ----------
  { "name": "Agony", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 141,
    "description": "Your bite is agony that no drug or power dulls; short of a coma, every feeding becomes a fight for the victim's life." },
  { "name": "Anachronism", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 141,
    "description": "Roll Intelligence to deal meaningfully with anything from after your breathing days; on failure you can't use it. Usually 100+ years undead." },
  { "name": "Anorexic Eater", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 141,
    "description": "Never take more than 2 Vitae from one source or more than 6 in a night." },
  { "name": "Bloodline and Magi Flaws", "kind": "Flaw", "source": "Vampire", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 141,
    "description": "Whenever your Bloodline or Magi House weakness causes a problem, it counts as suffering a 2-point Flaw for XP." },
  { "name": "Child", "kind": "Flaw", "source": "Vampire", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 141,
    "description": "Embraced as a small child: −2 dice on rolls where being taken seriously matters, and Hunger-related rolls are one harder." },
  { "name": "Bloodline Enmity", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 141,
    "description": "Members of one other Bloodline hold you in contempt: −2 dice on social dealings with them." },
  { "name": "Conspicuous Consumption", "kind": "Flaw", "source": "Vampire", "cost": "2", "minDots": 2, "maxDots": 2, "sourcePage": 141,
    "description": "You gain nourishment only by also eating the victim's blood-soaked organs, which always kills them. Eating a vampire's organs does 1 Aggravated per organ, and only vampires with 5+ Vitae are viable food." },
  { "name": "Damned", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 141,
    "description": "Destined to become a monster: 1 less die on Humanity checks." },
  { "name": "Deep Sleeper", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 141,
    "description": "Very hard to wake: reduced pools on rolls to awaken, and you're never on time after sleeping." },
  { "name": "Infamous Sire", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 142,
    "description": "Your sire is distrusted and disliked by many of the city's vampires, and so are you." },
  { "name": "Sire's Resentment", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 142,
    "description": "Your sire wishes you ill and may harm or attack you given the chance; their friends work against you and many elders resent you." },
  { "name": "Infectious Bite", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 142,
    "description": "You carry the diseases of those you drink from and pass them on, until your pool is spent down to 1." },
  { "name": "Moon-Kissed", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 142,
    "description": "Moonlight burns you as ambient (indirect) sunlight." },
  { "name": "No Reflection", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 142,
    "description": "You cast no reflection in any reflective surface." },
  { "name": "Permanent Wound", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 142,
    "description": "Each night you rise with 3 Lethal in the same location from your Embrace. It heals normally but returns every sunset.",
    "restrictions": "Not for Brujah." },
  { "name": "Scent of the Beast", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 142,
    "description": "Humans and animals sense your Beast from a city block away: −1 with animals; at Blood Potency 6+, −2 with animals and −1 with mortals. These penalties become bonuses to Persuasion when frightening prey." },
  { "name": "Stench of the Grave", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 142,
    "description": "You smell of a rotting corpse, detectable a block away, whatever you do." },
  { "name": "Taint of Corruption", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 142,
    "description": "Plants up to your size wither as you approach and die at your touch." },
  { "name": "Territorial", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 142,
    "description": "Outside your territory you're nervous and disoriented (all pools worse by one); a Dominion roll whenever someone enters it without permission." },
  { "name": "Thinblood", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 142,
    "description": "Starting Generation 13 and a Blood Pool 3 smaller than normal; your blood only sustains and heals. You can't Blood Bond, and an Embrace fails half the time (never retried on the same target)." },
  { "name": "Turned", "kind": "Flaw", "source": "Vampire", "cost": "1", "minDots": 1, "maxDots": 1, "sourcePage": 142,
    "description": "Repelled by a substance or item (a cross, garlic, black cats…): you flee it, and are at −4 if you can't." }
]
